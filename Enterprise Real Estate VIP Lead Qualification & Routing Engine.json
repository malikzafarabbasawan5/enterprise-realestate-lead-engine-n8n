    {
      "parameters": {
        "jsCode": "const rawOutput = $input.first().json.output || \"{}\";\nconst lead = $('02 - Normalize Lead Payload').item.json;\n\nlet parsed = {};\ntry {\n  const cleaned = rawOutput.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  const isHighVal = lead.declared_budget_pkr >= 15000000;\n  parsed = {\n    intent_score: isHighVal ? 88 : 55,\n    buyer_segment: isHighVal ? \"VIP_INVESTOR\" : \"STANDARD_INQUIRY\",\n    recommended_action: isHighVal ? \"Priority phone outreach\" : \"Nurture via email\",\n    custom_pitch_angle: \"Prime residential and commercial opportunities aligned with client portfolio.\"\n  };\n}\n\nconst isVip = (parsed.buyer_segment === \"VIP_INVESTOR\") || (Number(parsed.intent_score) >= 80) || (lead.declared_budget_pkr >= 15000000);\n\nreturn [{\n  json: {\n    ...lead,\n    intent_score: Number(parsed.intent_score) || 60,\n    buyer_segment: isVip ? \"VIP_INVESTOR\" : \"STANDARD_INQUIRY\",\n    recommended_action: parsed.recommended_action,\n    custom_pitch_angle: parsed.custom_pitch_angle,\n    is_vip: isVip,\n    qualified_at: new Date().toISOString()\n  }\n}];"
      },
