    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\n// Parse budget numbers clean\nlet rawBudget = String(body.budget || \"0\").toLowerCase();\nlet numericBudget = 0;\n\nif (rawBudget.includes(\"crore\") || rawBudget.includes(\"cr\")) {\n  numericBudget = parseFloat(rawBudget.replace(/[^0-9.]/g, \"\")) * 10000000;\n} else if (rawBudget.includes(\"lac\") || rawBudget.includes(\"lakh\")) {\n  numericBudget = parseFloat(rawBudget.replace(/[^0-9.]/g, \"\")) * 100000;\n} else if (rawBudget.includes(\"m\")) {\n  numericBudget = parseFloat(rawBudget.replace(/[^0-9.]/g, \"\")) * 1000000;\n} else {\n  numericBudget = parseFloat(rawBudget.replace(/[^0-9.]/g, \"\")) || 0;\n}\n\nreturn [{\n  json: {\n    lead_id: \"RE-\" + Math.floor(10000 + Math.random() * 90000),\n    full_name: body.name || \"Anonymous Lead\",\n    contact_email: body.email || \"client-lead@example.com\",\n    contact_phone: body.phone || \"Not Provided\",\n    inquiry_message: body.message || \"Looking for luxury residential plot or villa for immediate purchase.\",\n    declared_budget_pkr: numericBudget,\n    location_preference: body.location || \"Prime Commercial / Residential Zone\",\n    timeline: body.timeline || \"Immediate / 30 Days\",\n    ingested_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -304,
        -48
      ],
      "id": "37d98cc2-1726-4f6d-9ee6-39ec09e2a85b",
      "name": "02 - Normalize Lead Payload"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Lead ID: {{ $json.lead_id }}\nFull Name: {{ $json.full_name }}\nDeclared Budget (PKR): {{ $json.declared_budget_pkr }}\nPreferred Location: {{ $json.location_preference }}\nPurchase Timeline: {{ $json.timeline }}\nMessage/Requirement: {{ $json.inquiry_message }}",
        "options": {
          "systemMessage": "You are an Enterprise Real Estate Investment Director and High-Net-Worth Lead Qualifier.\nEvaluate the lead inquiry data.\n\nOutput a single strict JSON object without markdown wrappers with these exact keys:\n- \"intent_score\": integer from 1 to 100 based on urgency, realistic budget, and timeline\n- \"buyer_segment\": \"VIP_INVESTOR\" (if budget >= 15000000 or intent_score >= 80), otherwise \"STANDARD_INQUIRY\"\n- \"recommended_action\": clear directive for sales team (e.g. \"Immediate phone outreach within 10 minutes\")\n- \"custom_pitch_angle\": tailored 2-sentence value proposition matching their budget & location"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -80,
        -48
      ],
      "id": "518f6040-09cf-4c0d-a92c-224cd66023f3",
